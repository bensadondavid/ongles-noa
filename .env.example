# Inngest (requis en production ; le Dev Server Inngest les remplace en local)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Recommandé en production à la place de TWILIO_AUTH_TOKEN
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Optionnel en sandbox ; requis pour utiliser votre template approuvé en production
TWILIO_APPOINTMENT_REMINDER_CONTENT_SID=
